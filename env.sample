# ============================================================
# Weights & Biases
# ============================================================

# Required for online logging.
# Create/copy your key from your W&B account and keep the real .env private.
WANDB_API_KEY=your_wandb_api_key_here

# W&B project name.
WANDB_PROJECT=qwen35-vqa

# Optional. Leave empty to use your default W&B account/team.
WANDB_ENTITY=

# Optional. Leave empty to let W&B generate a run name automatically.
WANDB_RUN_NAME=qwen35-4b-fulltrain-2ep

# online  : upload logs to W&B in real time
# offline : save W&B logs locally without an API key/network
# disabled: disable W&B entirely
WANDB_MODE=online

# Optional comma-separated tags.
WANDB_TAGS=qwen3.5-4b,lora,full-train,aug-1to1,half-epoch-checkpoints
